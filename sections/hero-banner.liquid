<section class="hero" aria-label="Hero banner">
      <div class="container">
        <div class="hero__inner">
          <div class="hero__media">
            <img src="{{ 'hero-specialty-coffee.svg' | asset_url }}" alt="Hand holding a specialty coffee bag" width="900" height="1000">
          </div>
          <div class="hero__content">
            <h1 class="hero__title">Special <span>Coffee</span></h1>
            <p class="hero__text">Morbi justo vel diam non leo elementum massa. Molestie ipsum condimentum egestas vitae ut cras aenean enim. Laoreet odio adipiscing auctor scelerisque phasellus nisl faucibus.</p>
            <a href="#shop" class="btn btn--outline">Order Now</a>
          </div>
        </div>
      </div>
    </section>
{% schema %}
{
  "name": "Hero Banner",
  "settings": [],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
