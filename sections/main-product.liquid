<section class="container"><h1>{{ product.title | escape }}</h1>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | image_tag: alt: product.title }}{% endif %}<p>{{ product.price | money }}</p>{{ product.description }}{% form 'product', product %}<select name='id'>{% for variant in product.variants %}<option value='{{ variant.id }}'>{{ variant.title }} ? {{ variant.price | money }}</option>{% endfor %}</select><button name='add'>Add to cart</button>{% endform %}</section>
{% schema %}
{
  "name": "Product",
  "settings": [],
  "presets": [
    {
      "name": "Product"
    }
  ]
}
{% endschema %}
