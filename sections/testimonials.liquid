<section class="testimonials" aria-label="Customer testimonials">
      <div class="container">
        <div class="testimonials__inner">
          <button type="button" class="round-btn" aria-label="Previous testimonial">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <figure class="testimonials__item">
            <blockquote class="testimonials__quote">“Habitant aliquet sed suspendisse lectus sit gravida sit morbi augue. Porta cursus diam sit velit mi. Maecenas scelerisque tellus nulla ut vitae amet morbi platea blandit vestibulum dignissim.”</blockquote>
            <figcaption class="testimonials__author">Sarah Anderson</figcaption>
          </figure>
          <button type="button" class="round-btn round-btn--dark" aria-label="Next testimonial">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>
    </section>
