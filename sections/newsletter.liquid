<section class="newsletter" aria-labelledby="newsletter-title">
      <div class="container">
        <div class="newsletter__inner">
          <h2 class="section-title" id="newsletter-title">Subscribe Us</h2>
          <p class="newsletter__text">Subscribe to our newsletter for discount codes and updates.</p>
          <form class="newsletter__form" action="#" method="post">
            <label for="newsletter-email" class="visually-hidden">Email address</label>
            <input type="email" id="newsletter-email" name="email" placeholder="Write your email address here..." required>
            <button type="submit" class="newsletter__btn">Subscribe</button>
          </form>
          <ul class="social">
            <li><a href="#" aria-label="Facebook"><img src="{{ 'social-facebook.svg' | asset_url }}" alt="" width="14" height="14"></a></li>
            <li><a href="#" aria-label="Instagram"><img src="{{ 'social-instagram.svg' | asset_url }}" alt="" width="14" height="14"></a></li>
            <li><a href="#" aria-label="Twitter"><img src="{{ 'social-twitter.svg' | asset_url }}" alt="" width="14" height="14"></a></li>
            <li><a href="#" aria-label="LinkedIn"><img src="{{ 'social-linkedin.svg' | asset_url }}" alt="" width="14" height="14"></a></li>
            <li><a href="#" aria-label="YouTube"><img src="{{ 'social-youtube.svg' | asset_url }}" alt="" width="14" height="14"></a></li>
          </ul>
        </div>
      </div>
    </section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
