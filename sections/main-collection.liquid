<section class="container"><h1>{{ collection.title | escape }}</h1>{{ collection.description }}{% paginate collection.products by 12 %}<ul>{% for product in collection.products %}<li><a href='{{ product.url }}'>{{ product.title | escape }} ? {{ product.price | money }}</a></li>{% endfor %}</ul>{{ paginate | default_pagination }}{% endpaginate %}</section>
{% schema %}
{
  "name": "Collection",
  "settings": [],
  "presets": [
    {
      "name": "Collection"
    }
  ]
}
{% endschema %}
