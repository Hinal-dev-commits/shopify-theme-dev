<header class="header" id="site-header">
    <div class="container">
      <div class="header__inner">

        <input type="checkbox" id="nav-toggle" class="header__toggle-input">
        <label for="nav-toggle" class="header__burger" aria-label="Toggle menu"><span></span></label>

        <nav class="header__nav" aria-label="Main navigation">
          <ul class="header__menu">
            <li><a href="{{ routes.root_url }}" class="is-active">Home</a></li>
            <li><a href="#shop">Shop</a></li>
            <li><a href="#blog">Blog</a></li>
            <li><a href="#pages">Pages</a></li>
          </ul>
        </nav>

        <a href="{{ routes.root_url }}" class="header__logo" aria-label="Beanie – home">
          <img src="{{ 'logo.svg' | asset_url }}" alt="Beanie – best coffee shop since 1987" width="180" height="110">
        </a>

        <div class="header__actions">
          <form class="header__search" role="search" action="{{ routes.search_url }}" method="get">
            <input type="search" name="q" placeholder="Search here..." aria-label="Search">
            <button type="submit" aria-label="Search">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </button>
          </form>
          <a href="#" class="header__icon" aria-label="Wishlist">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </a>
          <a href="#" class="header__icon header__cart" aria-label="Cart">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            <span class="header__cart-count">(01)</span>
          </a>
        </div>

      </div>
    </div>
  </header>
{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
